# Values have NO surrounding quotes and NO inline comments. $ stays literal.
# Create a Desktop OAuth client, fill its ID/secret, then run authorize_google.py locally.
GOOGLE_CLIENT_ID=REPLACE.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

ICLOUD_USERNAME=replace@example.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ICLOUD_CALENDAR_NAME=Google
SYNC_ID=google-to-icloud
ICLOUD_CALDAV_URL=https://caldav.icloud.com/

# Fast: rolling last 7 days -> unlimited future, every 600 seconds.
# History: local midnight 6 calendar months ago -> rolling 7 days ago, once per local day.
# Google: syncToken deltas; iCloud: changed resources only, full audit once per local day.
SYNC_INTERVAL=600
SYNC_TIMEZONE=Asia/Shanghai
HTTP_TIMEOUT=30
SYNC_DELETE=true
DELETE_CONFIRMATIONS=2
DELETE_MAX_COUNT=20
DELETE_MAX_RATIO=0.5
DELETE_RATIO_MIN_COUNT=5
MAX_RESPONSE_BYTES=20971520
GOOGLE_MAX_PAGES=1000
STATE_FILE=data/state.json

